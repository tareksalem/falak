# -*- mode: ruby -*-
# vi: set ft=ruby :

# All Vagrant configuration is done below. The "2" in Vagrant.configure
# configures the configuration version (we support older styles for
# backwards compatibility). Please don't change it unless you know what
# you're doing.
Vagrant.configure("2") do |config|
  # The most common configuration options are documented and commented below.
  # For a complete reference, please see the online documentation at
  # https://docs.vagrantup.com.

  # Every Vagrant development environment requires a box. You can search for
  # boxes at https://vagrantcloud.com/search.
  config.vm.box = "hashicorp-education/ubuntu-24-04"
  config.vm.box_version = "0.1.0"

  config.vm.provision "shell", inline: <<-SHELL
    set -e
    sudo apt-get update
    sudo apt-get install -y wget git build-essential curl
    if ! go version | grep -q "go1.24"; then
      wget -q https://go.dev/dl/go1.24.0.linux-amd64.tar.gz
      sudo rm -rf /usr/local/go
      sudo tar -C /usr/local -xzf go1.24.0.linux-amd64.tar.gz
      rm go1.24.0.linux-amd64.tar.gz
    fi
    if ! grep -q 'export PATH=$PATH:/usr/local/go/bin' /etc/profile; then
      echo 'export PATH=$PATH:/usr/local/go/bin' | sudo tee -a /etc/profile
    fi
    export PATH=$PATH:/usr/local/go/bin
    if ! command -v dlv >/dev/null 2>&1; then
      go install github.com/go-delve/delve/cmd/dlv@latest
      sudo cp ~/go/bin/dlv /usr/local/bin/
    fi
    if ! command -v air >/dev/null 2>&1; then
      curl -sSfL https://raw.githubusercontent.com/cosmtrek/air/master/install.sh | sh -s -- -b ~/go/bin
      sudo cp ~/go/bin/air /usr/local/bin/
    fi
    echo "Go version: $(go version)"
    echo "Delve version: $(dlv version)"
    echo "Air version: $(air --version || true)"
  SHELL

  config.vm.define "node1" do |node1|
    node1.vm.network "forwarded_port", guest: 2345, host: 2345
    node1.vm.network "forwarded_port", guest: 4001, host: 4001
    node1.vm.synced_folder "..", "/vagrant", type: "virtualbox"
    node1.vm.provision "shell", inline: <<-SHELL
    echo '#!/bin/bash
    cd /vagrant
    nohup air -- --name=node1 --port=4001 > /vagrant/air_node1.log 2>&1 &' > /home/vagrant/start_air.sh
    chmod +x /home/vagrant/start_air.sh
    (crontab -l 2>/dev/null; echo "@reboot /home/vagrant/start_air.sh") | crontab -
  SHELL
  end

  config.vm.define "node2" do |node2|
    node2.vm.network "forwarded_port", guest: 2345, host: 2346
    node2.vm.network "forwarded_port", guest: 4002, host: 4002
    node2.vm.synced_folder "..", "/vagrant", type: "virtualbox"
    node2.vm.provision "shell", inline: <<-SHELL
    echo '#!/bin/bash
    cd /vagrant
    nohup air -- --name=node2 --port=4002 > /vagrant/air_node2.log 2>&1 &' > /home/vagrant/start_air.sh
    chmod +x /home/vagrant/start_air.sh
    (crontab -l 2>/dev/null; echo "@reboot /home/vagrant/start_air.sh") | crontab -
  SHELL
  end
end
